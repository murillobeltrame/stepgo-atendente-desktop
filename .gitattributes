# Padrão de quebra de linha: LF (servidores são Linux; .sh com CRLF quebra o deploy).
# Vale mesmo no Windows: o git entrega e grava LF.
* text=auto eol=lf

# Scripts do Windows precisam de CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binários — nunca converter
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary
*.zip binary
*.db binary
*.apk binary
*.aab binary
*.jar binary
